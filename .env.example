# Copy to .env.local and fill in real values. Do not commit .env.local.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Editor token from sanity.io/manage → API → Tokens. Server-only. Needed to read
# the (private) dataset and to save enquiries from the contact form.
SANITY_API_TOKEN=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
CONTACT_EMAIL=hello@poiyee.com
